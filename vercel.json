{
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://admin.wonghiran.com" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://shop-api.wonghiran.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
